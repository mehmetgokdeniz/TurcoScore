# TurcoScore — ortam değişkenleri / API yapılandırması
# Kopyalayın: .env.example -> .env  (dosyanın kendisi git'e girer, .env girmez)
#
# NOT: TurcoScore'un API ANAHTARI GEREKTİRMEZ. Aşağıdaki değerler uygulamanın
# kullandığı açık uçların referansıdır; bir kaynak anahtar isterse (ör. lisanslı
# skor API'si) değer buraya eklenir ve .env git dışında tutulur.

# --- ESPN (aktif skor kaynağı, anahtarsız) ---
ESPN_SITE_BASE_URL=https://site.api.espn.com
ESPN_CORE_BASE_URL=https://sports.core.api.espn.com
ESPN_LOGO_CDN_URL=https://a.espncdn.com/i/teamlogos/soccer/500
ESPN_HEADSHOT_CDN_URL=https://a.espncdn.com/i/headshots/soccer/players/full

# --- Maçkolik (Türk ligleri / oyuncu profilleri, anahtarsız) ---
MACKOLIK_BASE_URL=https://arsiv.mackolik.com
MACKOLIK_IMAGE_CDN_URL=https://im.mackolik.com

# --- SofaScore (pasif kaynak, kod korunuyor; 403/captcha nedeniyle kapalı) ---
SOFASCORE_PRIMARY_URL=https://www.sofascore.com/api/v1
SOFASCORE_BACKUP_URL=https://api.sofascore.com/api/v1

# --- Gelecekte anahtarlı kaynak kullanacaksanız buraya ekleyin ---
# FOOTBALL_DATA_API_KEY=
# API_FOOTBALL_KEY=
